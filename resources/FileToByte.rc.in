// Windows version resource for FileToByte. Configured by CMake into the build
// directory (see CMakeLists.txt) so the version is defined in exactly one
// place: project(FileToByte VERSION ...). No icon is included on purpose; the
// provenance/license of assets/Icon.ico is unverified.
#include <windows.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Jerimiah"
            VALUE "FileDescription", "FileToByte - converts files into compressed C arrays"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "InternalName", "FileToByte"
            VALUE "LegalCopyright", "Copyright (c) 2023 Jerimiah"
            VALUE "OriginalFilename", "FileToByte.exe"
            VALUE "ProductName", "FileToByte"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
