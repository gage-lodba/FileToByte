# clangd looks for compile_commands.json next to a source file or in a parent
# dir, but CMake writes it into the build directory. Point clangd there so
# includes that come transitively from VulkanWindow (imgui.h, imgui_stdlib.h,
# ...) resolve.
#
# The build directory must be generated by a single-config generator: Ninja or
# Unix Makefiles write compile_commands.json (CMakeLists.txt sets
# CMAKE_EXPORT_COMPILE_COMMANDS=ON), while the Visual Studio generator does not.
# On Windows, configure the clangd tree with e.g.:
#   cmake -B build -G Ninja
CompileFlags:
  CompilationDatabase: build
